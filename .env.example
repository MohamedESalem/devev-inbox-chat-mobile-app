# Public app identity/configuration. Do not place private credentials in this file.
EXPO_PUBLIC_APP_SLUG=devev-inbox
EXPO_PUBLIC_EXPO_OWNER=
EXPO_PUBLIC_PROJECT_ID=

# The production app is fixed to the DEVEV Chatwoot server in src/config/devev.ts.
EXPO_PUBLIC_DEVEV_ENABLE_SSO=false
EXPO_PUBLIC_DEVEV_ALLOW_SERVER_OVERRIDE=false
EXPO_PUBLIC_MINIMUM_CHATWOOT_VERSION=4.1.0

# Optional DEVEV-owned support chat widget. Leave empty until configured.
EXPO_PUBLIC_DEVEV_SUPPORT_WEBSITE_TOKEN=
EXPO_PUBLIC_DEVEV_SUPPORT_BASE_URL=https://inbox.devev.net

# Optional DEVEV-owned observability/analytics. Leave empty unless DEVEV owns the project.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_PROJECT_NAME=
EXPO_PUBLIC_SENTRY_ORG_NAME=
EXPO_PUBLIC_JUNE_SDK_KEY=

# Firebase client config file paths. The files are ignored by Git and can be injected in CI/EAS.
EXPO_PUBLIC_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
EXPO_PUBLIC_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# Expo/Apple values are used by EAS only. Keep actual secrets in GitHub/EAS secrets.
EXPO_APPLE_ID=
EXPO_APPLE_TEAM_ID=
EXPO_STORYBOOK_ENABLED=false
